{
  "host": "127.0.0.1",
  "port": 8765,
  "default_ocr": "local",
  "cloud_ocr": {
    "provider": "paddleocr",
    "endpoint_env": "PADDLEOCR_API_URL",
    "token_env": "PADDLEOCR_ACCESS_TOKEN"
  },
  "security": {
    "bind_localhost_by_default": true,
    "agent_calls_should_use_http_or_cli_only": true
  }
}
