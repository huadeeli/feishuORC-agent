# Feishu self-built app credentials. Fill these in .env, never commit secrets.
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OCR routing. Cloud PP-OCRv5 is tried first, then local mobile.
ORC_OCR_MODE=auto
ORC_OCR_PRIMARY=cloud
ORC_OCR_FALLBACK=local-fast
ORC_TEMPLATE_ID=auto
ORC_CLI_PATH=orc-calc.py
# Portable packages set this to app\ocr_cache at launch.
# ORC_CALC_OCR_CACHE_DIR=ocr_cache
# Source diagnostics may point to an existing portable OCR runtime.
# ORC_CALC_OCR_RUNTIME_DIR=..\app\ocr-runtime

# Token may stay empty. The application will automatically use local mobile OCR.
PADDLEOCR_API_URL=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs
PADDLEOCR_ACCESS_TOKEN=
PADDLEOCR_CLOUD_MODEL=PP-OCRv5

# Optional runtime settings.
# ORC_PYTHON=python
ORC_COMMAND_TIMEOUT=900
ORC_FEISHU_MAX_WORKERS=2
ORC_FEISHU_RUNTIME_DIR=runtime/feishu
ORC_FEISHU_LOG_LEVEL=INFO
ORC_FEISHU_SDK_LOG_LEVEL=WARNING
ORC_FEISHU_REPLY_STYLE=card
# auto: send result immediately after image; form: send fee input card first.
ORC_FEISHU_IMAGE_WORKFLOW=auto
